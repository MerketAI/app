# Application
NODE_ENV=development
PORT=3002
APP_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/marketing_automation

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3002/api/v1/auth/google/callback

# Meta (Facebook/Instagram)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# WordPress
WORDPRESS_CLIENT_ID=your-wordpress-client-id
WORDPRESS_CLIENT_SECRET=your-wordpress-client-secret

# Jasper AI
JASPER_API_KEY=your-jasper-api-key
JASPER_API_URL=https://api.jasper.ai/v1

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379

# ============================================
# Object storage - Cloudflare R2
# ============================================
# Required for design export and for Instagram/TikTok publishing: those
# platforms download media by URL, so assets must be publicly reachable.
# R2 has no ACLs - make the bucket public in the Cloudflare dashboard and put
# its public hostname (or your custom domain) in R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=jasper-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# AWS S3 - only used when the R2 values above are absent
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=ap-south-1

# ============================================
# Market intelligence
# ============================================
# Google Trends (local trending keywords) + Google Ads Transparency Center
SERPAPI_KEY=your-serpapi-key
# Meta Ad Library - observing competitors' actually-running ads.
# Note: outside the EU this API only covers social-issue/electoral/political
# ads, so an empty result does not prove a competitor is running nothing.
META_AD_LIBRARY_TOKEN=your-meta-ad-library-token

# ============================================
# Background jobs
# ============================================
# Scheduled publishing, analytics sync and trend refresh all run in-process.
# Set to false on every instance except one when running more than one replica,
# otherwise each replica runs its own copy of the jobs.
JASPER_SCHEDULER_ENABLED=true

# ============================================
# Design asset layer
# ============================================
# Vector icons come from the Iconify public API - no key, no account. Only
# permissively-licensed sets are requested (Health Icons, Tabler, Phosphor,
# Lucide, Material Design Icons: MIT / ISC / Apache-2.0).
#
# Stock photography is optional. Both APIs have free tiers.
# NOTE: none of these licences includes a MODEL RELEASE. Never present a stock
# person as your practitioner, staff, patient or client.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Override the Chrome used for design rendering. Required in slim Docker
# images, and the escape hatch when Puppeteer's pinned build will not download.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ============================================
# Artwork generation (the illustrated layer of a design)
# ============================================
# The model draws the PICTURE only. Copy, contact details and logos are
# composited as HTML on top, because diffusion models garble text and a wrong
# phone number on a printed flyer is a real problem.
OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenAI-compatible base URL (Azure OpenAI, or a gateway). Blank = api.openai.com
# OPENAI_BASE_URL=

# S3-compatible object storage (MinIO, Ceph). Blank = real AWS.
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# ============================================
# Photo layer
# ============================================
# Practitioner cutouts. remove.bg is the implemented provider - a paid API with
# plain commercial terms. Local ONNX removers (@imgly, rembg) are loaded
# dynamically if installed, but @imgly ships a custom licence rather than an
# SPDX one, so check it before using that route commercially.
REMOVEBG_API_KEY=
