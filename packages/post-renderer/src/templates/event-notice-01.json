{
  "schemaVersion": "1.0.0",
  "id": "event-notice-01",
  "templateVersion": "1.2.0",
  "title": "Event notice",
  "family": "medical-editorial",
  "status": "active",
  "formats": [
    "instagram_square",
    "instagram_portrait"
  ],
  "referenceFormat": "instagram_square",
  "description": "Social announcement for a camp, awareness day, seasonal campaign or offer. An accent masthead carries the occasion, a panel holds the date, time and venue, and the practitioner is named above the call to action. Needs no photograph, which is the point: it is the layout available when there is nothing to photograph.",
  "campaignTypes": [
    "event",
    "health_camp",
    "awareness",
    "offer",
    "seasonal",
    "announcement"
  ],
  "theme": {
    "mood": "clinical",
    "background": "surface"
  },
  "capabilities": {
    "maxServices": 3,
    "supportsCutout": false,
    "supportsPhoto": false,
    "supportsTimings": true,
    "supportsBadges": false
  },
  "slots": {
    "brandName": {
      "kind": "text",
      "source": "profile",
      "profileField": "clinicName",
      "required": true,
      "maxChars": 46,
      "maxLines": 2,
      "minFontSize": 19,
      "maxFontSize": 28,
      "overflow": "shrink"
    },
    "eyebrow": {
      "kind": "text",
      "source": "campaign",
      "required": false,
      "maxChars": 34,
      "maxLines": 1,
      "minFontSize": 22,
      "maxFontSize": 34,
      "overflow": "shrink",
      "fallback": "hide",
      "description": "What the post announces, in a few words: 'Free dental camp', 'World Oral Health Day'. Shown as a pill on the masthead."
    },
    "headline": {
      "kind": "richtext",
      "source": "campaign",
      "required": true,
      "maxChars": 72,
      "maxLines": 3,
      "minFontSize": 34,
      "maxFontSize": 56,
      "overflow": "shrink",
      "description": "The message. Emphasise the phrase that carries it."
    },
    "subheadline": {
      "kind": "text",
      "source": "campaign",
      "required": false,
      "maxChars": 120,
      "maxLines": 2,
      "minFontSize": 19,
      "maxFontSize": 25,
      "overflow": "shrink",
      "fallback": "hide"
    },
    "details": {
      "kind": "keyvalue",
      "source": "campaign",
      "required": false,
      "maxItems": 3,
      "minFontSize": 19,
      "maxFontSize": 27,
      "overflow": "shrink",
      "fallback": "hide",
      "description": "Date, time and venue. A camp post is useless without them, and the venue is often not the practice address."
    },
    "highlights": {
      "kind": "list",
      "source": "campaign",
      "required": false,
      "maxItems": 3,
      "maxItemChars": 24,
      "minFontSize": 16,
      "maxFontSize": 22,
      "overflow": "shrink",
      "fallback": "hide",
      "description": "Three short reassurances at most: 'Free screening', 'All ages'."
    },
    "cta": {
      "kind": "text",
      "source": "campaign",
      "required": false,
      "maxChars": 34,
      "maxLines": 1,
      "minFontSize": 23,
      "maxFontSize": 32,
      "overflow": "shrink",
      "fallback": "hide"
    },
    "doctorName": {
      "kind": "text",
      "source": "profile",
      "profileField": "doctorName",
      "required": false,
      "maxChars": 46,
      "maxLines": 1,
      "minFontSize": 18,
      "maxFontSize": 24,
      "overflow": "shrink",
      "fallback": "hide"
    },
    "qualifications": {
      "kind": "text",
      "source": "profile",
      "profileField": "qualifications",
      "required": false,
      "maxChars": 72,
      "maxLines": 1,
      "minFontSize": 14,
      "maxFontSize": 18,
      "overflow": "shrink",
      "fallback": "hide"
    },
    "phone": {
      "kind": "text",
      "source": "profile",
      "profileField": "phone",
      "required": false,
      "maxChars": 24,
      "maxLines": 1,
      "overflow": "truncate",
      "fallback": "hide"
    },
    "website": {
      "kind": "text",
      "source": "profile",
      "profileField": "website",
      "required": false,
      "maxChars": 46,
      "maxLines": 1,
      "overflow": "truncate",
      "fallback": "hide"
    },
    "bookingUrl": {
      "kind": "text",
      "source": "profile",
      "profileField": "bookingUrl",
      "required": false,
      "maxChars": 46,
      "maxLines": 1,
      "overflow": "truncate",
      "fallback": "hide"
    }
  },
  "zones": [
