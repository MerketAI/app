{
  "schemaVersion": "1.0.0",
  "id": "clinic-profile-01",
  "templateVersion": "1.2.0",
  "title": "Practice profile",
  "family": "medical-editorial",
  "status": "active",
  "description": "Dense practice profile: headline, photo, service grid, consulting hours, trust badges and a contact bar. Suits a clinic that wants one asset answering what they do, when they are open and how to reach them.",
  "campaignTypes": [
    "clinic_profile",
    "services",
    "awareness"
  ],
  "formats": [
    "a4_portrait"
  ],
  "referenceFormat": "a4_portrait",
  "theme": {
    "mood": "clinical",
    "background": "surface"
  },
  "capabilities": {
    "maxServices": 8,
    "supportsCutout": false,
    "supportsPhoto": true,
    "supportsTimings": true,
    "supportsBadges": true
  },
  "slots": {
    "brandName": {
      "kind": "text",
      "source": "profile",
      "profileField": "clinicName",
      "required": true,
      "maxChars": 72,
      "maxLines": 2,
      "minFontSize": 24,
      "maxFontSize": 44,
      "overflow": "shrink",
      "description": "Practice or practitioner name, top left."
    },
    "headline": {
      "kind": "richtext",
      "source": "campaign",
      "required": true,
      "maxChars": 80,
      "maxLines": 3,
      "minFontSize": 42,
      "maxFontSize": 82,
      "overflow": "shrink",
      "description": "Main message. Emphasise the closing phrase."
    },
    "subheadline": {
      "kind": "text",
      "source": "campaign",
      "required": false,
      "maxChars": 120,
      "maxLines": 2,
      "minFontSize": 22,
      "maxFontSize": 32,
      "overflow": "shrink",
      "fallback": "hide"
    },
    "heroImage": {
      "kind": "image",
      "source": "asset",
      "required": false,
      "overflow": "hide",
      "fallback": "hide"
    },
    "servicesTitle": {
      "kind": "text",
      "source": "campaign",
      "required": false,
      "maxChars": 28,
      "maxLines": 1,
      "overflow": "truncate",
      "fallback": "placeholder",
      "placeholder": "Our services"
    },
    "services": {
      "kind": "list",
      "source": "campaign",
      "required": true,
      "maxItems": 8,
      "maxItemChars": 44,
      "minFontSize": 20,
      "maxFontSize": 32,
      "overflow": "shrink",
      "description": "Short service names. Two or three words read best."
    },
    "timings": {
      "kind": "keyvalue",
      "source": "campaign",
      "required": false,
      "maxItems": 4,
      "overflow": "hide",
      "fallback": "hide"
    },
    "badges": {
      "kind": "list",
      "source": "campaign",
      "required": false,
      "maxItems": 4,
      "maxItemChars": 24,
      "overflow": "hide",
      "fallback": "hide",
      "description": "Trust markers, rendered as centred cards."
    },
    "cta": {
      "kind": "text",
      "source": "campaign",
      "required": false,
      "maxChars": 40,
      "maxLines": 1,
      "minFontSize": 24,
      "maxFontSize": 40,
      "overflow": "shrink",
      "fallback": "hide"
    },
    "address": {
      "kind": "text",
      "source": "profile",
      "profileField": "address",
      "required": false,
      "maxChars": 160,
      "maxLines": 3,
      "overflow": "wrap",
      "fallback": "hide"
    },
    "phone": {
      "kind": "text",
      "source": "profile",
      "profileField": "phone",
      "required": false,
      "maxChars": 24,
      "maxLines": 1,
      "overflow": "truncate",
      "fallback": "hide"
    },
    "email": {
      "kind": "text",
      "source": "profile",
      "profileField": "email",
      "required": false,
      "maxChars": 48,
      "maxLines": 1,
      "overflow": "truncate",
      "fallback": "hide"
    },
    "website": {
      "kind": "text",
      "source": "profile",
      "profileField": "website",
      "required": false,
      "maxChars": 48,
      "maxLines": 1,
      "overflow": "truncate",
      "fallback": "hide"
    }
  },
  "zones": [
